# ─────────────────────────────────────────────────────────────
# BACKEND environment — copy to server/.env and fill in locally.
# These values are PRIVATE. Never commit server/.env.
# On Vercel, add the same keys under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# Comma-separated origins allowed to call the API (CORS). Same-origin on Vercel needs no entry.
CORS_ORIGINS=http://localhost:5173

# Public URL of the deployed site (used in sitemap + emails)
SITE_URL=https://muhammadhamza-iota.vercel.app

# ── Firebase Admin SDK (Firebase console → Project settings → Service accounts → Generate new private key)
FIREBASE_PROJECT_ID=portfolio-f82f5
FIREBASE_CLIENT_EMAIL=
# Paste the private key in quotes; keep the \n sequences exactly as in the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Cloudinary (Cloudinary console → Settings → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# ── Resend (resend.com → API Keys)
RESEND_API_KEY=
CONTACT_EMAIL=hamzaadvani8547@gmail.com
# Without a verified domain Resend only allows "onboarding@resend.dev" and only delivers to your own account email.
RESEND_FROM="Portfolio Contact <onboarding@resend.dev>"
# Acknowledgement emails to visitors need a verified domain. Set to true after verifying one.
RESEND_SEND_ACKNOWLEDGEMENT=false

# ── GitHub (optional) — a fine-grained token with no scopes raises the API rate limit from 60 to 5000/hour
GITHUB_USERNAME=Hamza-Advani
GITHUB_TOKEN=

# ── Local development only ───────────────────────────────────
# When Firebase Admin is NOT configured, the API uses a JSON file store (server/.data/db.json)
# so you can try the whole site and admin locally. This token lets you sign in to /admin
# locally without Firebase. It is ignored when NODE_ENV=production or on Vercel.
DEV_ADMIN_TOKEN=
