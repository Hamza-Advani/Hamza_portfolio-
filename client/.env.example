# ─────────────────────────────────────────────────────────────
# FRONTEND environment — copy to client/.env.local
# Everything prefixed VITE_ is bundled into public browser JavaScript.
# Firebase web config values are designed to be public (access is enforced by
# Firebase Auth + Firestore rules + the API). NEVER put secrets here
# (no Cloudinary secret, no Resend key, no service-account keys).
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=portfolio-f82f5.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=portfolio-f82f5
VITE_FIREBASE_STORAGE_BUCKET=portfolio-f82f5.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1011077731716
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: only if the API is hosted somewhere other than the same domain (/api).
VITE_API_URL=
